/* YoinkTUI — global styles & theme */

Screen {
    background: $surface;
    color: $text;
}

/* Base palette — deep charcoal + teal accent */
$bg: #0a0e14;
$surface: #111827;
$surface-raised: #1a2234;
$surface-hover: #1f2a40;
$text: #e5e9f0;
$text-muted: #6b7c93;
$accent: #00d4aa;
$accent-dim: #00d4aa80;
$warning: #f5a623;
$error: #ff4757;
$success: #00d4aa;
$border: #2a3a52;
$border-focus: #00d4aa;
$overlay: #000000cc;

/* --- Layout helpers ---------------------------------------------------- */

MainView {
    layout: vertical;
    height: 100%;
}

Sidebar {
    width: 36;
    background: $surface-raised;
    border-right: solid $border;
}

ContentArea {
    width: 1fr;
    layout: vertical;
    overflow: hidden;
}

/* --- Header / Footer --------------------------------------------------- */

Header {
    background: $surface-raised;
    color: $accent;
    text-style: bold;
}

Footer {
    background: $surface-raised;
    color: $text-muted;
}

Button:focus {
    text-style: bold underline;
}

/* --- Widgets ----------------------------------------------------------- */

UrlInput {
    margin: 1 2;
    border: tall $border;
    background: $surface;
    color: $text;
    padding: 0 1;
}

UrlInput:focus {
    border: tall $border-focus;
}

UrlInput.-invalid {
    border: tall $error;
}

UrlInput.-loading {
    border: tall $warning;
}

FormatTable {
    height: 1fr;
    width: 1fr;
    margin: 1 2;
    border: solid $border;
    background: $surface;
}

FormatTable:focus {
    border: solid $border-focus;
}

FormatTable > .datatable--header {
    background: $surface-raised;
    color: $text-muted;
    text-style: bold;
}

FormatTable > .datatable--cursor {
    background: $accent-dim;
    color: $text;
}

FormatTable .datatable--row-hover {
    background: $surface-hover;
}

/* Zebra stripes — even rows get a slightly lighter background */
FormatTable > .datatable--even-row {
    background: $surface;
}

FormatTable > .datatable--odd-row {
    background: $surface-raised;
}

/* Selected (confirmed) row styling */
.selected-row {
    text-style: bold;
    background: $accent-dim;
    color: $text;
}

.ActionBar {
    height: auto;
    width: 100%;
    layout: horizontal;
    align: left middle;
    padding: 0 1;
}

.ActionBar Button {
    width: auto;
    min-width: 8;
    margin: 0 1 0 0;
    padding: 0 1;
}

.action-spacer {
    width: 1fr;
}

#btn_download {
    margin-right: 0;
    margin-left: 1;
}

#dismiss {
    margin-left: 2;
}

/* --- Download manager -------------------------------------------------- */

.download-manager {
    width: 100%;
    height: 1fr;
    margin: 0;
    padding: 1 2;
    background: $surface-raised;
    border: thick $accent;
    layout: vertical;
}

.dl-actions {
    height: 3;
    width: 100%;
    margin-top: 1;
    layout: horizontal;
    align: left middle;
}

.dl-actions Button {
    width: auto;
    margin-right: 1;
}

ProgressBar {
    margin: 0;
}

StatusToast {
    margin: 1;
    padding: 0 1;
    background: $surface-raised;
    border: solid $border;
    min-height: 2;
    max-height: 3;
}

ThumbnailCard {
    width: 32;
    height: 18;
    margin: 0;
    background: $surface;
    border: solid $border;
    content-align: center middle;
    border-title-color: $accent;
    border-title-style: bold;
}

ThumbnailCard.-loading {
    border: solid $warning;
}

ThumbnailCard.-error {
    border: solid $error;
}

InfoPanel {
    margin: 0 1;
    padding: 1;
    background: $surface-raised;
    border: solid $border;
}

InfoLabel {
    color: $text-muted;
    height: 1;
}

InfoValue {
    color: $text;
    height: 1;
}

/* --- Animations -------------------------------------------------------- */

.LoadingSpinner {
    width: 1;
    height: 1;
    color: $accent;
}

.LoadingShimmer {
    background: $surface-hover;
}

/* --- Modal screens ----------------------------------------------------- */

ModalScreen {
    background: $overlay;
}

ModalDialog {
    width: 80;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 2;
}

ModalTitle {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
    content-align: center middle;
}

ModalBody {
    margin: 1 0;
}

ModalButtons {
    layout: horizontal;
    margin-top: 1;
    content-align: right middle;
}

ModalButtons Button {
    margin-left: 2;

}

/* Helper classes */
.hidden {
    display: none;
}

/* --- Screen-specific styles -------------------------------------------- */

/* UrlScreen / startup error */
UrlScreen,
StartupErrorScreen {
    layout: vertical;
    align: center middle;
}
UrlScreen .center-box,
StartupErrorScreen .center-box {
    width: 80;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 3;
    layout: vertical;
    overflow: hidden;
}
UrlScreen .logo-wrap {
    width: 100%;
    height: auto;
    align: center middle;
    margin-bottom: 1;
}
UrlScreen .logo {
    width: 36;
    height: auto;
}
UrlScreen .title,
StartupErrorScreen .title {
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
    content-align: center middle;
}
UrlScreen .version {
    color: $text-muted;
    margin-bottom: 1;
    content-align: center middle;
}
UrlScreen .subtitle,
StartupErrorScreen .subtitle {
    color: $text-muted;
    margin-bottom: 1;
    content-align: center middle;
}
StartupErrorScreen .title {
    margin-bottom: 1;
}
StartupErrorScreen .message {
    color: $text;
    margin-bottom: 1;
}
UrlScreen .url-actions {
    height: 3;
    layout: horizontal;
    align: center middle;
    margin-top: 1;
}
UrlScreen .url-actions Button {
    width: auto;
    min-width: 12;
    margin: 0 1;
}

/* Inline probe status */
UrlScreen .probe-status {
    margin-top: 1;
    margin-bottom: 1;
    content-align: center middle;
    color: $text-muted;
    height: 1;
}

UrlScreen .probe-status.hidden {
    display: none;
}

/* FormatScreen */
FormatScreen {
    layout: vertical;
}
FormatScreen .top-row {
    layout: horizontal;
    height: 1fr;
    min-height: 18;
}
FormatScreen .left-pane {
    width: 1fr;
}
FormatScreen .right-pane {
    width: 40%;
    min-width: 38;
    max-width: 60;
}

/* DownloadScreen — Steam-style download manager */
DownloadScreen {
    layout: vertical;
}

/* Playlist / queue / library pages */
PlaylistScreen,
QueueScreen,
LibraryScreen {
    layout: vertical;
}
.page {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    background: $surface-raised;
    border: thick $accent;
    layout: vertical;
}
.page-kicker {
    height: 1;
    color: $accent;
    text-style: bold;
}
.page-title {
    height: 2;
    color: $text;
    text-style: bold;
}
.page-subtitle {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}
.playlist-controls {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-top: 1;
}
.playlist-controls Button {
    width: auto;
    min-width: 11;
    margin: 0 1 0 0;
}
.selection-actions {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-top: 1;
}
.selection-actions Button {
    width: auto;
    min-width: 11;
    margin: 0 1 0 0;
}
.control-label {
    width: auto;
    height: 3;
    padding: 0 1;
    content-align: left middle;
    color: $text-muted;
}
.playlist-controls Select {
    width: 18;
    height: 3;
    margin-right: 1;
}
.page-actions {
    height: 3;
    layout: horizontal;
    align: left middle;
    margin-top: 1;
}
.page-actions Button {
    width: auto;
    min-width: 11;
    margin: 0 1 0 0;
}
.page DataTable {
    height: 1fr;
    background: $surface;
    border: solid $border;
}
.playlist-page DataTable,
.queue-page DataTable {
    min-height: 8;
}
.library-page #library-search {
    height: 3;
    margin-bottom: 1;
    border: tall $border;
    background: $surface;
    color: $text;
    padding: 0 1;
}
.library-detail {
    height: auto;
    max-height: 5;
    padding: 0 1;
    margin-top: 1;
    color: $text-muted;
    border-left: thick $accent;
}

/* Preset modal */
PresetModal {
    align: center middle;
}
PresetModal .dialog {
    width: 100;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 3;
    overflow-y: auto;
}
PresetModal .title {
    color: $accent;
    text-style: bold;
}
PresetModal .clip-hint {
    color: $text-muted;
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}
PresetModal DataTable {
    height: auto;
    max-height: 14;
    background: $surface;
    border: solid $border;
}
PresetModal .clip-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
    margin-top: 1;
}
PresetModal .clip-actions Button {
    width: auto;
    margin-left: 1;
}

ErrorModal {
    align: center middle;
    background: $background 60%;
}
ErrorModal .dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    background: $surface-raised;
    border: thick $error;
    padding: 2 3;
    overflow-y: auto;
}
ErrorModal .message {
    margin-bottom: 1;
    color: $text;
}

/* ConfirmModal — destructive action confirmation */
ConfirmModal {
    align: center middle;
    background: $background 60%;
}
ConfirmModal .dialog {
    width: 64;
    max-width: 92%;
    height: auto;
    max-height: 90%;
    background: $surface-raised;
    border: thick $error;
    padding: 2 3;
    overflow-y: auto;
}
ConfirmModal .title {
    color: $error;
    text-style: bold;
}
ConfirmModal .message {
    margin-bottom: 1;
    color: $text;
}
ConfirmModal .confirm-actions {
    layout: horizontal;
    height: 3;
    align: right middle;
}
ConfirmModal .confirm-actions Button {
    width: auto;
    min-width: 10;
    margin-left: 2;
}

/* ClipModal — optional start/end range */
ClipModal {
    align: center middle;
}
ClipModal .dialog {
    width: 76;
    max-width: 92%;
    height: auto;
    max-height: 96%;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 3;
    overflow-y: auto;
}
ClipModal .title {
    color: $accent;
    text-style: bold;
}
ClipModal .clip-hint {
    color: $text-muted;
    height: auto;
    min-height: 1;
}
ClipModal .clip-row {
    layout: horizontal;
    height: 4;
}
ClipModal .clip-field {
    width: 1fr;
    height: 4;
    layout: vertical;
    margin-right: 2;
}
ClipModal .clip-label {
    color: $text-muted;
    height: 1;
}
ClipModal Input {
    height: 3;
    border: tall $border;
    background: $surface;
    color: $text;
    padding: 0 1;
}
ClipModal Input:focus {
    border: tall $border-focus;
}
ClipModal .clip-presets {
    layout: horizontal;
    height: 3;
}
ClipModal .clip-presets Button {
    width: auto;
    min-width: 10;
    margin-right: 1;
}
ClipModal .clip-precise {
    layout: horizontal;
    height: auto;
    min-height: 1;
    align: left middle;
}
ClipModal Switch {
    width: auto;
    height: 3;
}
ClipModal .clip-precise .clip-hint {
    margin-left: 1;
    content-align: left middle;
}
ClipModal .clip-error {
    color: $error;
    height: auto;
    min-height: 1;
}
ClipModal .clip-actions {
    layout: horizontal;
    height: 3;
    align: right middle;
}
ClipModal .clip-actions Button {
    width: auto;
    min-width: 10;
    margin-left: 2;
}

/* StatusToast */
StatusToast {
    width: 100%;
    height: 4;
    min-height: 4;
    max-height: 4;
    overflow: hidden;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    background: $surface-raised;
    border: solid $border;
}

/* ModalDialog */
ModalDialog {
    width: 80;
    height: auto;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 2;
}

/* ThumbnailCard */
ThumbnailCard {
    width: 100%;
    height: 18;
    content-align: center middle;
    border-title-color: $accent;
    border-title-style: bold;
}
ThumbnailCard > AutoImage {
    width: 100%;
    height: 100%;
}
ThumbnailCard .placeholder {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-style: bold;
    color: $text-muted;
    background: $surface-hover;
}
ThumbnailCard.-loading .placeholder {
    color: $warning;
}
ThumbnailCard.-error .placeholder {
    color: $error;
}
ThumbnailCard .hidden {
    display: none;
}
