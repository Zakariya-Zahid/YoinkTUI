/* YoinkTUI — global styles & theme */

Screen {
    background: $surface;
    color: $text;
}

/* Base palette — deep charcoal + teal accent */
$bg: #0a0e14;
$surface: #111827;
$surface-raised: #1a2234;
$surface-hover: #1f2a40;
$text: #e5e9f0;
$text-muted: #6b7c93;
$accent: #00d4aa;
$accent-dim: #00d4aa80;
$warning: #f5a623;
$error: #ff4757;
$success: #00d4aa;
$border: #2a3a52;
$border-focus: #00d4aa;
$overlay: #000000cc;

/* --- Layout helpers ---------------------------------------------------- */

MainView {
    layout: vertical;
    height: 100%;
}

Sidebar {
    width: 36;
    background: $surface-raised;
    border-right: solid $border;
}

ContentArea {
    width: 1fr;
    layout: vertical;
    overflow: hidden;
}

/* --- Header / Footer --------------------------------------------------- */

Header {
    background: $surface-raised;
    color: $accent;
    text-style: bold;
    border-bottom: solid $border;
}

Footer {
    background: $surface-raised;
    color: $text-muted;
    border-top: solid $border;
}

/* --- Widgets ----------------------------------------------------------- */

UrlInput {
    margin: 1 2;
    border: tall $border;
    background: $surface;
    color: $text;
    padding: 0 1;
}

UrlInput:focus {
    border: tall $border-focus;
}

UrlInput.-invalid {
    border: tall $error;
}

UrlInput.-loading {
    border: tall $warning;
}

FormatTable {
    height: 1fr;
    width: 1fr;
    margin: 1 2;
    border: solid $border;
    background: $surface;
}

FormatTable:focus {
    border: solid $border-focus;
}

FormatTable > .datatable--header {
    background: $surface-raised;
    color: $text-muted;
    text-style: bold;
}

FormatTable > .datatable--cursor {
    background: $accent-dim;
    color: $text;
}

FormatTable .datatable--row-hover {
    background: $surface-hover;
}

/* Zebra stripes — even rows get a slightly lighter background */
FormatTable > .datatable--even-row {
    background: $surface;
}

FormatTable > .datatable--odd-row {
    background: $surface-raised;
}

/* Selected (confirmed) row styling */
.selected-row {
    text-style: bold;
    background: $accent-dim;
    color: $text;
}

ActionBar {
    height: auto;
    width: 100%;
    layout: horizontal;
    align: left middle;
    padding: 0 1;
}

ActionBar Button {
    width: auto;
    margin: 0 1 0 0;
}

.action-spacer {
    width: 1fr;
}

#btn_download {
    margin-right: 0;
    margin-left: 1;
}

#dismiss {
    margin-left: 2;
}

/* --- Download manager -------------------------------------------------- */

.download-manager {
    width: 100%;
    height: 1fr;
    margin: 0;
    padding: 1 2;
    background: $surface-raised;
    border: thick $accent;
    layout: vertical;
}

.dl-actions {
    height: 3;
    width: 100%;
    margin-top: 1;
    layout: horizontal;
    align: left middle;
}

.dl-actions Button {
    width: auto;
    margin-right: 1;
}

ProgressBar {
    margin: 0;
}

StatusToast {
    margin: 1;
    padding: 0 1;
    background: $surface-raised;
    border: solid $border;
    min-height: 2;
    max-height: 3;
}

ThumbnailCard {
    width: 32;
    height: 18;
    margin: 0;
    background: $surface;
    border: solid $border;
    content-align: center middle;
    border-title-color: $accent;
    border-title-style: bold;
}

ThumbnailCard.-loading {
    border: solid $warning;
}

ThumbnailCard.-error {
    border: solid $error;
}

InfoPanel {
    margin: 0 2;
    padding: 1;
    background: $surface-raised;
    border: solid $border;
}

InfoLabel {
    color: $text-muted;
    height: 1;
}

InfoValue {
    color: $text;
    height: 1;
}

/* --- Animations -------------------------------------------------------- */

.LoadingSpinner {
    width: 1;
    height: 1;
    color: $accent;
}

.LoadingShimmer {
    background: $surface-hover;
}

/* --- Modal screens ----------------------------------------------------- */

ModalScreen {
    background: $overlay;
}

ModalDialog {
    width: 80;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 2;
}

ModalTitle {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
    content-align: center middle;
}

ModalBody {
    margin: 1 0;
}

ModalButtons {
    layout: horizontal;
    margin-top: 1;
    content-align: right middle;
}

ModalButtons Button {
    margin-left: 2;
    
}

/* Helper classes */
.hidden {
    display: none;
}

/* --- Screen-specific styles -------------------------------------------- */

/* UrlScreen */
UrlScreen {
    layout: vertical;
    align: center middle;
}
UrlScreen .center-box {
    width: 80;
    max-width: 90%;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 3;
    layout: vertical;
}
UrlScreen .logo-wrap {
    width: 100%;
    height: auto;
    align: center middle;
    margin-bottom: 1;
}
UrlScreen .logo {
    width: 36;
    height: auto;
}
UrlScreen .title {
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
    content-align: center middle;
}
UrlScreen .version {
    color: $text-muted;
    margin-bottom: 1;
    content-align: center middle;
}
UrlScreen .subtitle {
    color: $text-muted;
    margin-bottom: 1;
    content-align: center middle;
}

/* Inline probe status */
UrlScreen .probe-status {
    margin-top: 1;
    margin-bottom: 1;
    content-align: center middle;
    color: $text-muted;
    height: 1;
}

UrlScreen .probe-status.hidden {
    display: none;
}

/* FormatScreen */
FormatScreen {
    layout: vertical;
}
FormatScreen .top-row {
    layout: horizontal;
    border: solid red;
    height: 1fr;
    min-height: 22;
}
FormatScreen .left-pane {
    width: 1fr;
    
    border:solid white;
}
FormatScreen .right-pane {
    width: 60;
    min-width: 60;
    
    border:solid white;
}

/* DownloadScreen — Steam-style download manager */
DownloadScreen {
    layout: vertical;
}

ErrorModal .dialog {
    width: 70;
    background: $surface-raised;
    border: thick $error;
    padding: 2 3;
}
ErrorModal .message {
    margin-bottom: 1;
    color: $text;
}

/* StatusToast */
StatusToast {
    width: 100%;
    height: auto;
    min-height: 2;
    max-height: 3;
    background: $surface-raised;
    border: solid $border;
}

/* ModalDialog */
ModalDialog {
    width: 80;
    height: auto;
    background: $surface-raised;
    border: thick $accent;
    padding: 1 2;
}

/* ThumbnailCard */
ThumbnailCard {
    width: 60;
    height: 18;
    content-align: center middle;
    border-title-color: $accent;
    border-title-style: bold;
}
ThumbnailCard > AutoImage {
    width: 100%;
    height: 100%;
}
ThumbnailCard .placeholder {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-style: bold;
    color: $text-muted;
    background: $surface-hover;
}
ThumbnailCard.-loading .placeholder {
    color: $warning;
}
ThumbnailCard.-error .placeholder {
    color: $error;
}
ThumbnailCard .hidden {
    display: none;
}
